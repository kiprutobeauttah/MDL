{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDL",
  "version": "1.0.0",
  "identifier": "com.beauttah.mdl",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MDL - Mobile Diagnostic Lab",
        "width": 1000,
        "height": 750,
        "minWidth": 900,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Mobile Diagnostic Lab",
    "longDescription": "MDL connects to Android devices through USB or Wireless Debugging, continuously collects telemetry, and presents it through a real-time desktop interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
